{
	"name": "portfolio-website",
	"private": true,
	"type": "module",
	"description": "Modern portfolio website built with GoFront",
	"author": "Portfolio Owner",
	"license": "MIT",
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"scripts": {
		"prepare": "lefthook install && npm run prep",
		"prep": "node scripts/build.js content && gofront prep",
		"dev": "node scripts/build.js dev",
		"prod": "npm run check && node scripts/build.js clean && node scripts/build.js content && gofront prep --minify && gofront src -o public/app.js --minify --mangle && node scripts/build.js post",
		"test:gofront": "gofront test src --dom",
		"test:e2e": "playwright test",
		"test:build": "node --test \"tests/build/**/*.test.js\"",
		"test:all": "npm run test:gofront && npm run test:e2e && npm run test:build",
		"format": "biome format --write .",
		"check": "biome check . && gofront src --check"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@fontsource/raleway": "^5.3.0",
		"@playwright/test": "^1.63.0",
		"gofront": "^1.2.3",
		"jsdom": "^30.1.0",
		"lefthook": "^2.1.14",
		"rolldown": "^1.1.2",
		"yaml": "^2.8.3"
	},
	"dependencies": {
		"@emailjs/browser": "^4.4.1",
		"fuse.js": "^7.5.0",
		"marked": "^18.0.13",
		"prismjs": "^1.30.0"
	},
	"vendor": {
		"dest": [
			"app/vendor.js",
			"public/vendor.js"
		],
		"minify": true,
		"packages": [
			"fuse.js",
			"marked",
			"prismjs",
			"prismjs/components/prism-go.js",
			"prismjs/components/prism-bash.js",
			"prismjs/components/prism-yaml.js"
		],
		"globals": {
			"fuse.js": [
				"Fuse"
			],
			"prismjs": [
				"Prism"
			]
		}
	},
	"publicAssets": [
		"index.html",
		"boot.js",
		"favicon.svg",
		"og-image.jpg",
		"robots.txt",
		"fonts",
		"css"
	],
	"assetCopy": [
		{
			"source": "node_modules/@fontsource/raleway/files/raleway-latin-400-normal.woff2",
			"dest": "app/fonts/raleway-latin-400-normal.woff2"
		},
		{
			"source": "node_modules/@fontsource/raleway/files/raleway-latin-600-normal.woff2",
			"dest": "app/fonts/raleway-latin-600-normal.woff2"
		},
		{
			"source": "node_modules/@fontsource/raleway/files/raleway-latin-700-normal.woff2",
			"dest": "app/fonts/raleway-latin-700-normal.woff2"
		},
		{
			"source": "node_modules/prismjs/themes/prism-coy.min.css",
			"dest": "app/css/prism-themes/prism-coy.min.css"
		},
		{
			"source": "node_modules/prismjs/themes/prism-tomorrow.min.css",
			"dest": "app/css/prism-themes/prism-tomorrow.min.css"
		}
	]
}
