package main

css pageViewStyle() {
	& .about-pic {
		width: min(150px, 30vw);
		aspect-ratio: 1 / 1;
		height: auto;
		border-radius: 50%;
		margin-bottom: 20px;
		object-fit: cover;
		transition: transform var(--transition-normal);
	}
	& .about-pic:hover {
		transform: scale(1.05);
	}
}

templ PageView(v ViewState) {
	if v.Status == LoadFailed {
		<div class={ "error-message " + errorMessageStyle() }>
			<h1>{ t("general.notFound") }</h1>
			<p>{ t("general.notFoundMessage") }</p>
		</div>
	} else {
		<div class={ "page-view " + pageViewStyle() }>
			<div class={ "markdown-body " + markdownBodyStyle() }>
				@templ.Raw(v.HTML)
			</div>
		</div>
	}
}
