package main

// Icon renders a named SVG icon from the registry in icons.go.
// Unknown names render nothing.
templ Icon(name string, size string) {
	if icons[name].Path != "" {
		<svg class={ "icon icon-" + name } width={ size } height={ size } viewBox={ icons[name].ViewBox } fill="currentColor" aria-hidden="true">
			<path d={ icons[name].Path }></path>
		</svg>
	}
}
