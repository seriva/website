{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["scripts/**/*.js", "app/css/app.css"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"includes": ["scripts/**/*.js", "app/css/app.css"]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"includes": ["scripts/**/*.js", "app/css/app.css"],
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["app/css/app.css"],
			"linter": {
				"rules": {
					"complexity": { "noImportantStyles": "off" },
					"style": { "noDescendingSpecificity": "off" }
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
