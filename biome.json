{
	"$schema": "https://biomejs.dev/schemas/2.3.6/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**/app/src/**/*.js", "!**/app/src/dependencies"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"includes": ["**/app/src/**/*.js", "!**/app/src/dependencies"]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"includes": ["**/app/src/**/*.js", "!**/app/src/dependencies"],
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["app/src/styles/main.styles.js", "app/src/main.js"],
			"assist": {
				"actions": {
					"source": {
						"organizeImports": "off"
					}
				}
			}
		}
	]
}
