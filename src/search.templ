package main

templ SearchResultsList(results []SearchResultItem, query string, selectedIndex int) {
	if query != "" && len(results) == 0 {
		<div class="search-no-results">
			@Icon("search", "3rem")
			<p>{ t("search.noResults") }</p>
		</div>
	} else {
		for i, item := range results {
			<article class={ cls("search-result-item blog-post-card", i == selectedIndex, "selected") } data-action="open-post" data-href={ item.Url }>
				<h2 class="blog-post-title">
					<a href={ item.Url } data-action="nav">@templ.Raw(highlightMatch(item.Title, query))</a>
				</h2>
				<div class="blog-post-meta">
					<span class="blog-post-tags">
						if item.ItemType == "project" {
							<span class="item-tag">{ t("badges.project") }</span>
						} else {
							<span class="item-tag">{ t("badges.blog") }</span>
						}
						for _, tag := range item.Tags {
							<span class="item-tag">{ tag }</span>
						}
					</span>
				</div>
				<p class="blog-post-excerpt">@templ.Raw(highlightMatch(item.Description, query))</p>
			</article>
		}
	}
}

templ SearchModal(open bool, query string, results []SearchResultItem, selectedIndex int, placeholder string) {
	<div id="search-page" class={ cls("", open, "show") } role="dialog" aria-modal="true" aria-label={ t("aria.search") }>
		<div class="search-page-header">
			<div class="search-page-header-content">
				<button type="button" class="search-page-back" id="search-page-back" aria-label={ t("aria.goBack") } data-action="close-search">
					@Icon("arrow-left", "1.2rem")
				</button>
				<div class="search-page-input-wrapper">
					<input type="search" id="search-page-input" class="search-page-input" placeholder={ placeholder } autocomplete="off" aria-label={ t("aria.search") } value={ query }/>
					<button type="button" class={ cls("search-page-clear", query != "", "show") } id="search-page-clear" aria-label={ t("aria.clearSearch") } data-action="clear-search">
						@Icon("times", "1.2rem")
					</button>
				</div>
			</div>
		</div>
		<div class="search-page-content">
			<div class="search-page-results" id="search-page-results">
				@SearchResultsList(results, query, selectedIndex)
			</div>
		</div>
	</div>
}
