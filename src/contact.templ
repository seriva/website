package main

func contactModalClass(open bool, closing bool) string {
	if closing {
		return "show closing"
	}
	if open {
		return "show"
	}
	return ""
}

func inputErrorClass(hasErr bool) string {
	if hasErr {
		return "error"
	}
	return ""
}

func formStatusClass(statusType string) string {
	if statusType != "" {
		return "form-status " + statusType
	}
	return "form-status"
}

templ ContactModal() {
	<div id="contact-modal" class={ contactModalClass(contactOpen, contactClosing) }>
		<div class="contact-modal-content">
			<div class="contact-modal-header">
				<h2>{ t("contact.title") }</h2>
				<button class="contact-modal-close" id="contact-modal-close" aria-label={ t("contact.close") } data-action="close-contact">
					@IconTimes("1.2rem")
				</button>
			</div>
			<form class="contact-form" id="contact-form" novalidate>
				<div class="form-group">
					<label for="contact-name">{ t("contact.name") }*</label>
					<input type="text" id="contact-name" name="name" required class={ inputErrorClass(contactForm.ErrName) } value={ contactForm.Name }/>
				</div>
				<div class="form-group">
					<label for="contact-email">{ t("contact.email") }*</label>
					<input type="email" id="contact-email" name="email" required class={ inputErrorClass(contactForm.ErrEmail) } value={ contactForm.Email }/>
				</div>
				<div class="form-group">
					<label for="contact-message">{ t("contact.message") }*</label>
					<textarea id="contact-message" name="message" rows="6" required class={ inputErrorClass(contactForm.ErrMessage) }>{ contactForm.Message }</textarea>
				</div>
				<div class={ formStatusClass(contactForm.StatusType) } id="contact-status">
					<span>{ contactForm.StatusText }</span>
				</div>
				<button type="submit" class="btn btn-primary" id="contact-submit" disabled?={ contactForm.ButtonDisabled }>
					{ t("contact." + contactForm.ButtonState) }
				</button>
			</form>
		</div>
	</div>
}
