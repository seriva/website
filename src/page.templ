package main

templ PageView(v ViewState) {
	if v.Status == LoadFailed {
		<div class="error-message">
			<h1>{ t("general.notFound") }</h1>
			<p>{ t("general.notFoundMessage") }</p>
		</div>
	} else if v.Status == LoadPending {
		<div class="loading-spinner">{ t("general.loading") }</div>
	} else {
		<div class="page-view">
			<div class="markdown-body">
				@templ.Raw(v.HTML)
			</div>
		</div>
	}
}
