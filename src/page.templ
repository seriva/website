package main

templ PageView() {
	if currentPageError {
		<div class="error-message">
			<h1>{ t("general.notFound") }</h1>
			<p>{ t("general.notFoundMessage") }</p>
		</div>
	} else if currentPageLoading {
		<div class="loading-spinner">{ t("general.loading") }</div>
	} else {
		<div class="page-view">
			<div class="markdown-body">
				@templ.Raw(currentPageHtml)
			</div>
		</div>
	}
}
