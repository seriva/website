package main

import "strconv"

templ BlogPostCard(post BlogPost) {
    <article
    class="blog-post-card"
    data-action="open-post"
    data-href={ post.Href }
    role="article"
    aria-label={ post.Title }
    >
    <h2 class="blog-post-title">
        <a href={ post.Href } data-action="nav">{ post.Title }</a>
        </h2>
        <div class="blog-post-meta">
            <span class="blog-post-date">
                @Icon("calendar", "1rem")
                { " " + post.Date }
            </span>
            if len(post.Tags) > 0 {
                <span class="blog-post-tags">
                    for _, tag := range post.Tags {
                        <span class="item-tag clickable-tag" data-search-tag={ tag }>{ tag }</span>
                        }
                    </span>
                }
            </div>
            <p class="blog-post-excerpt">{ post.Excerpt }</p>
            </article>
        }

        templ Pagination(currentPage int, totalPages int) {
            <nav class="blog-pagination" aria-label="Blog pagination">
                <ul class="pagination">
                    <li class={ cls("page-item", currentPage <= 1, "disabled") }>
                        <a class="page-link" href={ pageHref(1) } data-action="nav" aria-label="First" title="First Page">
                            @Icon("angles-left", "0.85em")
                        </a>
                    </li>
                    <li class={ cls("page-item", currentPage <= 1, "disabled") }>
                        <a class="page-link" href={ pageHref(currentPage - 1) } data-action="nav" aria-label="Previous" title="Previous Page">
                            @Icon("chevron-left", "0.85em")
                        </a>
                    </li>
                    for _, pageNum := range pageNumbers(totalPages) {
                        <li class={ cls("page-item", pageNum == currentPage, "active") }>
                            <a class="page-link" href={ pageHref(pageNum) } data-action="nav">{ pageNum }</a>
                            </li>
                        }
                        <li class={ cls("page-item", currentPage >= totalPages, "disabled") }>
                            <a class="page-link" href={ pageHref(currentPage + 1) } data-action="nav" aria-label="Next" title="Next Page">
                                @Icon("chevron-right", "0.85em")
                            </a>
                        </li>
                        <li class={ cls("page-item", currentPage >= totalPages, "disabled") }>
                            <a class="page-link" href={ pageHref(totalPages) } data-action="nav" aria-label="Last" title="Last Page">
                                @Icon("angles-right", "0.85em")
                            </a>
                        </li>
                    </ul>
                </nav>
            }

            templ BlogList(allPosts []BlogPost, currentPage int, perPage int) {
                <div class="blog-container">
                    <h1 class="sr-only">{ t("nav.blog") }</h1>
                        if len(allPosts) == 0 {
                            <p class="blog-empty">{ t("blog.noPosts") }</p>
                            } else {
                                <div class="blog-posts">
                                    for _, post := range paginatedPosts(allPosts, currentPage, perPage) {
                                        @BlogPostCard(post)
                                    }
                                </div>
                                if calcTotalPages(len(allPosts), perPage) > 1 {
                                    @Pagination(currentPage, calcTotalPages(len(allPosts), perPage))
                                }
                            }
                        </div>
                    }

                    templ TableOfContents(items []TOCItem) {
                        if len(items) >= 2 {
                            <details class="blog-toc">
                                <summary class="blog-toc-title">{ t("blog.tableOfContents") }</summary>
                                    <nav class="blog-toc-nav" aria-label={ t("blog.tableOfContents") }>
                                        <ul class="blog-toc-list">
                                            for _, item := range items {
                                                <li class={ "blog-toc-item blog-toc-level-" + strconv.Itoa(item.Level) }>
                                                    <a href={ "#" + item.ID }>{ item.Text }</a>
                                                    </li>
                                                }
                                            </ul>
                                        </nav>
                                    </details>
                                }
                            }

                            templ BlogPostView(v ViewState, commentsEnabled bool) {
                                if v.Status == LoadNotFound || v.Status == LoadFailed {
                                    <div class="error-message">
                                        <h1>{ t("general.blogNotFound") }</h1>
                                            <p>{ t("general.blogNotFoundMessage") }</p>
                                            </div>
                                        } else {
                                            <div class="blog-post-view">
                                                <h1 class="project-title">{ v.Post.Title }</h1>
                                                    <p class="project-description">{ v.Post.Date }</p>
                                                        if len(v.Post.Tags) > 0 {
                                                            <div class="project-tags">
                                                                for _, tag := range v.Post.Tags {
                                                                    <span class="item-tag clickable-tag" data-search-tag={ tag }>{ tag }</span>
                                                                    }
                                                                </div>
                                                            }
                                                            @TableOfContents(v.TOC)
                                                            <div class="blog-post-content">
                                                                <div class="markdown-body">
                                                                    @templ.Raw(v.HTML)
                                                                </div>
                                                            </div>
                                                            if v.HasPrev || v.HasNext {
                                                                <nav class="download-buttons blog-post-nav" aria-label="Post navigation">
                                                                    if v.HasPrev {
                                                                        <a href={ v.PrevPost.Href } class="download-btn blog-nav-prev" data-action="nav" title={ v.PrevPost.Title }>
                                                                            @Icon("arrow-left", "1rem")
                                                                            <span>{ t("blog.previousPost") }</span>
                                                                            </a>
                                                                        }
                                                                        if v.HasNext {
                                                                            <a href={ v.NextPost.Href } class="download-btn blog-nav-next" data-action="nav" title={ v.NextPost.Title }>
                                                                                <span>{ t("blog.nextPost") }</span>
                                                                                    @Icon("arrow-right", "1rem")
                                                                                </a>
                                                                            }
                                                                        </nav>
                                                                    }
                                                                    if commentsEnabled {
                                                                        <div class="giscus-container"></div>
                                                                        }
                                                                    </div>
                                                                }
                                                            }
