package main

templ NotFoundView() {
	<div class="error-message">
		<h1>{ t("general.notFound") }</h1>
		<p>{ t("general.notFoundMessage") }</p>
		<div class="download-buttons" style="margin-top: 1.5rem;">
			<a href="/" class="btn btn-primary" data-action="nav">{ t("general.backToHome") }</a>
		</div>
	</div>
}

templ RouteView(r RouteMatch) {
	switch r.Kind {
	case RoutePost:
		@BlogPostView(view, site.Comments.BlogEnabled)
	case RouteProject:
		@ProjectDetail(view, site.Comments.ProjectsEnabled)
	case RoutePage:
		@PageView(view)
	case RouteNotFound:
		@NotFoundView()
	default:
		@BlogList(posts, r.Page, site.PostsPerPage)
	}
}

templ MainContent() {
	<main id="main-content" tabindex="-1">
		@RouteView(route)
	</main>
}

templ AppShell() {
	<div class="app-root">
		<a href="#main-content" class="skip-link">{ t("nav.skipToContent") }</a>
		<div id="route-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
		<div id="navbar-slot">
			@Navbar(route, navPages, projects, projectsDropdownOpen, mobileMenuOpen, site)
		</div>
		<div id="content-slot">
			@MainContent()
		</div>
		@Footer(currentYear(), site.Author)
		@SearchModal(searchOpen, searchQuery, searchResults, searchSelectedIndex, searchPlaceholderText())
		@ContactModal(contactOpen, contactForm)
	</div>
}
